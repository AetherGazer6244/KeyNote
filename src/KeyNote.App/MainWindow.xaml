<Window
    x:Class="KeyNote.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KeyNote">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 48px 通栏标题栏:品牌环 + 标题 + 状态胶囊 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <!-- 品牌标:18px 蓝环(与 icon.ico 同构,纯 XAML 绘制不依赖 ico 加载) -->
                <Ellipse Width="18" Height="18" StrokeThickness="3"
                         Stroke="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="KeyNote" FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" />
                <Border x:Name="StatusPill" CornerRadius="4" Padding="8,2"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusPillText" Text="记录中" FontSize="11" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 左侧导航:7 页,分「键鼠 / 设备 / 额度」三组(材质生效时 pane/content 全透明) -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="160"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="键鼠" />
                <NavigationViewItem Content="统计" Tag="stats">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource StatsGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="键鼠" Tag="keyboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource KeyboardGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="年度" Tag="heatmap">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource HeatmapGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="排行" Tag="topkeys">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource TopKeysGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="设备" />
                <NavigationViewItem Content="电量" Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource DevicesGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="额度" />
                <NavigationViewItem Content="AI 额度" Tag="quota">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource QuotaGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource SettingsGlyph}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <!-- 侧栏底部:暂停/继续 + 版本号(状态由 UpdateStatus 统一同步) -->
                <StackPanel Margin="12,0,12,14" Spacing="6">
                    <Button x:Name="PauseButton" Click="PauseButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="10,6" CornerRadius="4"
                            Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
                            <TextBlock x:Name="PauseText" Text="暂停记录" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="VersionText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Margin="14,0,0,0" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" Background="Transparent" />
        </NavigationView>
    </Grid>
</Window>
