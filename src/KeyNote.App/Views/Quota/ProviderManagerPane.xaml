<UserControl
    x:Class="KeyNote.App.Views.ProviderManagerPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行:返回卡片视图 + 标题 + 添加 -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnBack" Click="BtnBack_Click"
                    VerticalAlignment="Center" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14" Glyph="&#xE72B;" />
                    <TextBlock Text="返回" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" x:Name="PaneTitle"
                       Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="2" x:Name="BtnAdd" Click="BtnAdd_Click"
                    Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="10">

                <!-- 列表态 -->
                <Border x:Name="ListCard" Style="{StaticResource AppCardStyle}">
                    <StackPanel x:Name="ListPane" Spacing="10">
                        <ListView x:Name="ProviderList" SelectionMode="Single"
                                  DoubleTapped="ProviderList_DoubleTapped" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnEdit" Click="BtnEdit_Click" />
                            <Button x:Name="BtnDelete" Click="BtnDelete_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 表单态:类型 / url / key / model,其余走 quota.json -->
                <Border x:Name="FormCard" Style="{StaticResource AppCardStyle}"
                        Visibility="Collapsed">
                    <StackPanel x:Name="FormPane" Spacing="10">
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <!-- 标签列按内容自适应,窄窗口时输入框仍有空间 -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TxtKindLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="FKind" Grid.Column="1" MinWidth="128"
                                      DisplayMemberPath="Text"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="FKind_SelectionChanged" />
                            <TextBlock Text="Base URL" Grid.Row="1" VerticalAlignment="Center" />
                            <TextBox x:Name="FBaseUrl" Grid.Row="1" Grid.Column="1"
                                     LostFocus="FBaseUrl_LostFocus" />
                            <TextBlock Text="API Key" Grid.Row="2" VerticalAlignment="Center" />
                            <TextBox x:Name="FKey" Grid.Row="2" Grid.Column="1"
                                     LostFocus="FKey_LostFocus" />
                            <TextBlock Text="Model" Grid.Row="3" VerticalAlignment="Center" />
                            <ComboBox x:Name="FModel" Grid.Row="3" Grid.Column="1"
                                      IsEditable="True"
                                      SelectionChanged="FModel_SelectionChanged" />
                        </Grid>
                        <TextBlock x:Name="FormDetect"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" TextWrapping="Wrap" />
                        <TextBlock x:Name="FormError"
                                   Foreground="{StaticResource AppDangerBrush}"
                                   Visibility="Collapsed" TextWrapping="Wrap" />
                        <TextBlock x:Name="FormResult"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnTest" Click="BtnTest_Click" />
                            <Button x:Name="BtnSave" Click="BtnSave_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="BtnCancel" Click="BtnCancel_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
