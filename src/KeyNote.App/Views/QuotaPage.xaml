<Page
    x:Class="KeyNote.App.Views.QuotaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KeyNote.App.Controls"
    xmlns:local="using:KeyNote.App.Views">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,16">

        <!-- 页头:标题 + 副标题 + 管理/刷新 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="AI 额度" Style="{StaticResource AppPageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource AppPageSubtitleStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button x:Name="ManageButton" Click="Manage_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                        <TextBlock Text="管理" />
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 内容:provider 卡片 / 空态 / 管理面板(三态互斥) -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RowsHost" Spacing="8"
                            MaxWidth="640" HorizontalAlignment="Left" />
            </ScrollViewer>

            <controls:EmptyStateView x:Name="EmptyState" Visibility="Collapsed" />
            <local:ProviderManagerPane x:Name="ManagerPane" Visibility="Collapsed" />
        </Grid>

        <!-- 页脚:刷新时间 + 数量,各做成小胶囊(底部视觉锚点) -->
        <Grid x:Name="FooterGrid" Grid.Row="2" ColumnSpacing="8" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="4" Padding="8,3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    HorizontalAlignment="Left">
                <TextBlock x:Name="FooterUpdated" Style="{StaticResource CardFootnoteStyle}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            <Border Grid.Column="1" CornerRadius="4" Padding="8,3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock x:Name="FooterCount" Style="{StaticResource CardFootnoteStyle}" />
            </Border>
        </Grid>
    </Grid>
</Page>
